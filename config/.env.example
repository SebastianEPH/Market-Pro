# ------------------------------------------------------------------
# Market Pro - plantilla de variables de entorno
#
#   config/.env.example   esta plantilla (versionada)
#   config/.env.dev       desarrollo     (NO versionado)
#   config/.env.prod      producción     (NO versionado)
#   config/.env.<otro>    qa, staging...  (NO versionado)
#
# El entorno se elige con un argumento:  npm start -- dev   |   npm run db -- prod update
# El backend valida al arrancar todas sus variables y lista las que falten.
# En AWS Lambda no se usa archivo: estas mismas variables se configuran en cada función.
# ------------------------------------------------------------------

# APP - LOCAL | DEV | QA | PROD
APP_ENVIRONMENT=DEV
NODE_ENV=development
LOG_LEVEL=debug
GATEWAY_PORT=3000

# SEGURIDAD (JWT_SECRET de al menos 32 caracteres; compartido por los 3 microservicios)
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ISSUER=market-pro
JWT_AUDIENCE=market-pro-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
INTERNAL_API_KEY=cambia-esta-clave-interna-entre-microservicios
# Segundos que un microservicio cachea los permisos de un usuario (0 = tiempo real estricto)
ACCESS_CACHE_TTL_SECONDS=15
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# DATABASE - PostgreSQL 18. Una base por microservicio en el mismo servidor.
DATABASE_POSTGRESQL_HOST=localhost
DATABASE_POSTGRESQL_PORT=5432
DATABASE_POSTGRESQL_SSL=false
DATABASE_POSTGRESQL_CONNECTION_LIMIT=5
DATABASE_IDENTITY=market_identity
DATABASE_CATALOG=market_catalog
DATABASE_SALES=market_sales
# Rol de la APLICACIÓN (solo DML, sujeto a Row Level Security)
DATABASE_POSTGRESQL_USER=market_app
DATABASE_POSTGRESQL_PASSWORD=cambia-password-app
# Rol DUEÑO de las tablas: lo usa Liquibase para las migraciones
DATABASE_POSTGRESQL_OWNER_USER=market_owner
DATABASE_POSTGRESQL_OWNER_PASSWORD=cambia-password-owner
# SUPERUSUARIO: solo para crear roles y bases (npm run db:setup). En RDS: el usuario master.
DATABASE_POSTGRESQL_ADMIN_USER=postgres
DATABASE_POSTGRESQL_ADMIN_PASSWORD=cambia-password-superusuario

# LIQUIBASE - contextos a aplicar (dev incluye los datos demo; prod los excluye)
LIQUIBASE_CONTEXTS=dev

# MICROSERVICIOS - URL base de cada uno (local: gateway; AWS: API Gateway)
IDENTITY_SERVICE_URL=http://localhost:3000/identity
CATALOG_SERVICE_URL=http://localhost:3000/catalog
SALES_SERVICE_URL=http://localhost:3000/sales
SERVICE_TIMEOUT_MS=8000

# FRONTENDS (Vite solo expone las variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000
