# ------------------------------------------------------------------
# Market Pro - variables de entorno (copiar a .env)
# En Lambda cada función recibe solo las suyas; localmente el gateway
# carga todos los servicios en un proceso, por eso existen prefijos
# IDENTITY_ / CATALOG_ / SALES_ (tienen prioridad sobre la variable sin prefijo).
# ------------------------------------------------------------------

STAGE=local
LOG_LEVEL=debug
GATEWAY_PORT=3000

# Seguridad
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ISSUER=market-pro
JWT_AUDIENCE=market-pro-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
INTERNAL_API_KEY=cambia-esta-clave-interna-entre-microservicios

# Segundos que un microservicio cachea los permisos de un usuario.
# 0 = consulta a identity en cada request (tiempo real estricto).
ACCESS_CACHE_TTL_SECONDS=15

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL (docker compose) - credenciales del rol de aplicación (sujeto a RLS)
IDENTITY_DATABASE_URL=postgres://market_app:app_dev_password@localhost:5432/market_identity
CATALOG_DATABASE_URL=postgres://market_app:app_dev_password@localhost:5432/market_catalog
SALES_DATABASE_URL=postgres://market_app:app_dev_password@localhost:5432/market_sales
DB_POOL_MAX=5

# URLs base de cada microservicio (comunicación interna).
# Localmente todo pasa por el gateway; en AWS apuntan al API Gateway.
IDENTITY_SERVICE_URL=http://localhost:3000/identity
CATALOG_SERVICE_URL=http://localhost:3000/catalog
SALES_SERVICE_URL=http://localhost:3000/sales
SERVICE_TIMEOUT_MS=8000

# Docker compose
POSTGRES_PASSWORD=postgres
MARKET_OWNER_PASSWORD=owner_dev_password
MARKET_APP_PASSWORD=app_dev_password
